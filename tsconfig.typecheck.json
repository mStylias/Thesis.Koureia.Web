{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["libs/**/src/**/*.ts", "apps/**/src/**/*.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/out-tsc",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/test-setup.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}

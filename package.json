    "deploy:keycloak-theme": "nx run koureia-keycloak-theme:deploy-local",
    "watch": "nx build koureia --configuration development --watch",
    "test": "nx test koureia",
    "storybook": "nx run shared-ui-storybook-host:storybook",
    "build-storybook": "nx run shared-ui-storybook-host:build-storybook",
    "serve:ssr:koureia": "node dist/apps/koureia/server/server.mjs",
    "typecheck": "ngc -p tsconfig.typecheck.json",
    "typecheck:specs": "node tools/typecheck/check-specs.mjs",
    "check:tokens": "node tools/design-tokens/check-tokens.mjs",
    "check:prerender": "node tools/seo/check-prerender.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "node tools/lint/lint.mjs",
    "lint:fix": "node tools/lint/lint.mjs --fix"
  },
  "private": true,
  "packageManager": "pnpm@10.33.3",

{
  "name": "koureia",
  "version": "1.0.0",
  "scripts": {
    "start": "node tools/dev-env/dev-env.mjs && nx serve koureia",
    "setup:dev": "node tools/dev-env/dev-env.mjs",
    "build": "nx build koureia",
    "build:keycloak-theme": "nx build koureia-keycloak-theme",

          { "type": "element", "prefix": "auth", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "auth", "style": "camelCase" }
        ]
      }
    },
    {
      "files": ["libs/shared/util-language/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          { "type": "element", "prefix": "lang", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "lang", "style": "camelCase" }
        ]
      }
    },
    {
      "files": ["apps/koureia-keycloak-theme/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          { "type": "element", "prefix": "kc", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "kc", "style": "camelCase" }
        ]
      }
    },
    {
      // This library is the boundary where untyped wire data becomes typed. Its parsers narrow
      // `unknown` bodies field by field, so checks that the compiler reads as redundant are the
      // only thing between a malformed response and a runtime crash. Public API signatures spell
      // out their type arguments: `Result<T, HttpError>` documents the error contract in the
      // emitted .d.ts, which `Result<T>` does not.
      "files": ["libs/shared/data-access/synax/core/**/*.ts"],
      "plugins": ["typescript"],
      "rules": {
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-arguments": "off"
      }
    },
    {
      // Public API signatures spell out their type arguments, as in synax/core. `Result<void>` is
      // the void-success case of the result type.
      "files": ["libs/shared/data-access/synax/client/**/*.ts"],
      "plugins": ["typescript"],
      "rules": {
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/no-invalid-void-type": "off"
      }
    },
    {
      // Reads wire data, as synax/core does. An aggregation over an empty set answers with no rows
      // although `items[0]` is typed as present.
      "files": ["libs/shared/data-access/odata-source/**/*.ts"],
      "plugins": ["typescript"],
      "rules": {
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-arguments": "off"
      }
    }
  ]
}

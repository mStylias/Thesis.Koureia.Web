        "@angular-eslint/prefer-standalone": "error",
        "@angular-eslint/use-pipe-transform-interface": "error",
        "@angular-eslint/use-lifecycle-interface": "warn"
      }
    },
    {
      "files": ["libs/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          { "type": "element", "prefix": "lib", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "lib", "style": "camelCase" }
        ]
      }
    },
    {
      // Design-system components attach to native elements (`button[libButton]`), so attribute
      // selectors in camelCase are the norm in these libraries.
      "files": ["libs/shared/ui/button/**/*.ts", "libs/shared/ui/card/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          { "type": ["element", "attribute"], "prefix": "lib", "style": "camelCase" }
        ]
      }
    },
    {
      "files": ["libs/shared/ui/toaster/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          { "type": ["element", "attribute"], "prefix": "lib", "style": "kebab-case" }
        ]
      }
    },
    {
      "files": ["libs/auth/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/component-selector": [

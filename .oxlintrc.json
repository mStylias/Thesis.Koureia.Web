    {
      // Oxlint's versions of these rules report false positives. `no-useless-assignment` flags
      // `nextId++` in a field initializer. `prefer-optional-chain` rewrites a `typeof x` guard,
      // which throws during server rendering.
      "files": ["**/*.ts", "**/*.js", "**/*.mjs"],
      "plugins": ["typescript"],
      "rules": { "no-useless-assignment": "off", "typescript/prefer-optional-chain": "off" }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
      "jsPlugins": ["@nx/eslint-plugin"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": ["^.*/eslint(\\.base)?\\.config\\.[cm]?[jt]s$"],
            "depConstraints": [
              { "sourceTag": "scope:shared", "onlyDependOnLibsWithTags": ["scope:shared"] },
              // Auth owns the session and the identity of the person using the app.
              // It builds on shared foundations and must not reach into a feature
              // domain. Everything else depends on auth, never the reverse. The rule
              // is explicit because an unlisted scope is otherwise unconstrained.
              {
                "sourceTag": "scope:auth",
                "onlyDependOnLibsWithTags": ["scope:auth", "scope:shared"]
              },
              { "sourceTag": "type:ui", "onlyDependOnLibsWithTags": ["type:ui", "type:util"] },
              {
                "sourceTag": "type:feature",
                "onlyDependOnLibsWithTags": [
                  "type:ui",
                  "type:util",
                  "type:feature",
                  "type:data-access"
                ]
              },
              // Data-access speaks HTTP and owns wire shapes. It can reach utilities
              // and its siblings, never a ui or feature library. The dependency runs
              // the other way.
              {
                "sourceTag": "type:data-access",
                "onlyDependOnLibsWithTags": ["type:util", "type:data-access"]
              },
              // A theme holds the values of one brand. It can reach the brand-neutral
              // core it emits against, nothing else. `type:theme` is absent from every
              // list above on purpose: no ui or feature library can depend on a brand.
              { "sourceTag": "type:theme", "onlyDependOnLibsWithTags": ["type:ui"] },
              { "sourceTag": "type:app", "onlyDependOnLibsWithTags": ["*"] }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/**/*.ts", "libs/**/*.ts"],
      "jsPlugins": ["@angular-eslint/eslint-plugin"],
      "rules": {
        "@angular-eslint/contextual-lifecycle": "error",
        "@angular-eslint/no-empty-lifecycle-method": "error",

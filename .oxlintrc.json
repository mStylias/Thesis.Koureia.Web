{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Lints TypeScript and JavaScript. Angular templates are linted by ESLint (eslint.config.mjs),
  // because Oxlint cannot parse them. `pnpm lint` runs both.
  "plugins": ["unicorn"],

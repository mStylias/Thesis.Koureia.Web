{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "sortPackageJson": false,
  "associations": [
    {
      "files": ["*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": [
    "/dist",
    "/coverage",
    "/.nx/cache",
    "/.nx/workspace-data",
    ".angular",
    "/.pnpm-store",
    "pnpm-lock.yaml",
    "/apps/koureia-keycloak-theme/public/keycloakify-dev-resources"
  ]
}

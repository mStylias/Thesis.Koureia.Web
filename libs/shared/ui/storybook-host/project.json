{
  "name": "shared-ui-storybook-host",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/storybook-host/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 6110,
        "configDir": "libs/shared/ui/storybook-host/.storybook",
        "browserTarget": "shared-ui-storybook-host:build-storybook",
        "compodoc": true,
        "tsConfig": "libs/shared/ui/storybook-host/.storybook/tsconfig.json",
        "compodocArgs": [
          "-p",
          "libs/shared/ui/storybook-host/.storybook/tsconfig.docs.json",
          "-e",
          "json",
          "-d",
          "libs/shared/ui/storybook-host/.storybook"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/libs/shared/ui/*/src/**/*",
        "{workspaceRoot}/libs/shared/styles/src/**/*",
        "{workspaceRoot}/libs/themes/*/src/**/*"
      ],
      "options": {
        "outputDir": "dist/storybook/shared-ui-storybook-host",
        "configDir": "libs/shared/ui/storybook-host/.storybook",
        "browserTarget": "shared-ui-storybook-host:build-storybook",
        "compodoc": true,
        "tsConfig": "libs/shared/ui/storybook-host/.storybook/tsconfig.json",
        "compodocArgs": [
          "-p",
          "libs/shared/ui/storybook-host/.storybook/tsconfig.docs.json",
          "-e",
          "json",
          "-d",
          "libs/shared/ui/storybook-host/.storybook"
        ],
        "styles": ["libs/shared/styles/src/tailwind.css", "libs/themes/koureia/src/main.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/styles/src"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "shared-ui-storybook-host:build-storybook",
        "staticFilePath": "dist/storybook/shared-ui-storybook-host",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "shared-ui-storybook-host:build-storybook:ci"
        }
      }
    }
  }
}

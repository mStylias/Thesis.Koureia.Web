{
  "compileOnSave": false,
  "compilerOptions": {
    // The workspace root, because a relative path in an extended config
    // resolves against the file that declares it. A library that emits
    // declarations otherwise infers its own directory as the root, and every
    // import reached through a `paths` alias then sits outside it — TS6059 on
    // each one, in the editor only, because no build uses these configs to emit.
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
